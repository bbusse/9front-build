+static void
+e820maxmem(void)
+{
+	uvlong top, end;
+	char *s, *e;
+	int i, t;
+
+	if((i = findconf("*e820")) < 0)
+		return;
+	top = 0;
+	for(s = confval[i]; *s != '\0'; s = e){
+		t = strtoul(s, &e, 16);
+		if(e == s)
+			break;
+		strtoull(e, &e, 16);
+		end = strtoull(e, &e, 16);
+		if(t == 1 && end > top)
+			top = end;
+	}
+	if(top != 0){
+		snprint(maxmem, sizeof(maxmem), "%#llux", top);
+		addconf("*maxmem", maxmem);
+	}
+}
