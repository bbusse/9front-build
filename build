#!/usr/bin/env bash
#
# SPDX-FileCopyrightText: Björn Busse <bj.rn@baerlin.eu>
# SPDX-License-Identifier: BSD-3-Clause
#

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/qemu.sh
source "${here}/lib/qemu.sh"
QEMU_ARCH=amd64

arch="${ARCH:-amd64}"
version="${NINEFRONT_VERSION:-11952}"
iso_sha256="${NINEFRONT_ISO_SHA256:-59ba79f1304f02c1aae573b337fa2569fc78027ce8e4c2056c4117e971025b91}"
arm64_qcow2_sha256="${NINEFRONT_ARM64_QCOW2_SHA256:-f5cfd763d14377d918ad8389b83dc4ab2b23ba48ccfabf3f75eae27e0c1b5a15}"
repo_url="${NINEFRONT_REPO_URL:-https://9front.org/iso}"
image_size_mib="${IMAGE_SIZE_MIB:-4096}"
work="${WORK_DIR:-${PWD}/work}"
out="${OUT:-${PWD}/9front-${arch}.img}"
boot_timeout="${BOOT_TIMEOUT:-600}"
build_timeout="${BUILD_TIMEOUT:-5400}"

iso_gz="9front-${version}.amd64.iso.gz"
iso="${work}/9front-${version}.amd64.iso"
arm64_gz="9front-${version}.arm64.qcow2.gz"
arm64_qcow2="${work}/9front-${version}.arm64.qcow2"
arm64_dist="${work}/9front-${version}.arm64.raw"

export MTOOLS_SKIP_CHECK=1

log() {
    printf '9front-build: %s\n' "$*" >&2
}

die() {
    log "$*"
    exit 1
}

need() {
    local c
    for c in "$@"; do
        command -v "${c}" >/dev/null 2>&1 || die "missing ${c}"
    done
}

fetch_iso() {
    mkdir -p "${work}"

    if [ ! -f "${work}/${iso_gz}" ]; then
        log "fetching ${repo_url}/${iso_gz}"
        curl -sS --fail -L -o "${work}/${iso_gz}.part" "${repo_url}/${iso_gz}"
        mv "${work}/${iso_gz}.part" "${work}/${iso_gz}"
    fi

    log "verifying ${iso_gz}"
    printf '%s  %s\n' "${iso_sha256}" "${iso_gz}" >"${work}/${iso_gz}.sha256"
    if ! (cd "${work}" && sha256sum -c --quiet "${iso_gz}.sha256"); then
        die "checksum mismatch for ${iso_gz}, set NINEFRONT_ISO_SHA256 along with NINEFRONT_VERSION"
    fi

    if [ ! -f "${iso}" ]; then
        log "decompressing ${iso_gz}"
        gzip -d -k -c "${work}/${iso_gz}" >"${iso}.part"
        mv "${iso}.part" "${iso}"
    fi
}

fetch_arm64_dist() {
    if [ ! -f "${arm64_qcow2}" ]; then
        log "fetching ${repo_url}/${arm64_gz}"
        curl -sS --fail -L -o "${work}/${arm64_gz}.part" "${repo_url}/${arm64_gz}"
        gzip -d -c "${work}/${arm64_gz}.part" >"${arm64_qcow2}.part"
        rm -f "${work}/${arm64_gz}.part"
        mv "${arm64_qcow2}.part" "${arm64_qcow2}"
    fi

    log "verifying ${arm64_qcow2##*/}"
    printf '%s  %s\n' "${arm64_qcow2_sha256}" "${arm64_qcow2##*/}" >"${arm64_qcow2}.sha256"
    if ! (cd "${work}" && sha256sum -c --quiet "${arm64_qcow2##*/}.sha256"); then
        die "checksum mismatch for ${arm64_qcow2##*/}, set NINEFRONT_ARM64_QCOW2_SHA256 along with NINEFRONT_VERSION"
    fi

    if [ ! -f "${arm64_dist}" ]; then
        qemu-img convert -O raw "${arm64_qcow2}" "${arm64_dist}.part"
        mv "${arm64_dist}.part" "${arm64_dist}"
    fi
}

stage_arm64_patches() {
    local patch
    patch="${1}"
    mkdir -p "${patch}"

    xorriso -osirrox on -indev "${iso}" \
        -extract /sys/src/9/arm64/l.s "${patch}/l.s" \
        -extract /sys/src/9/arm64/bootargs.c "${patch}/bootargs.c" \
        -extract /sys/src/boot/efi/sub.c "${patch}/sub.c" \
        -extract /sys/src/boot/efi/aa64.s "${patch}/aa64.s" 2>/dev/null ||
        die "found no arm64 kernel and EFI loader sources on ${iso}"
    chmod u+w "${patch}"/*

    local p
    for p in "${here}"/patches/arm64/*.patch; do
        log "applying ${p##*/}"
        patch -s -p5 -d "${patch}" <"${p}" || die "${p##*/} does not apply"
    done
}

make_boot_disk() {
    local stage
    stage="${work}/stage"
    rm -rf "${stage}"
    mkdir -p "${stage}"

    mkdir -p "${stage}/386" "${stage}/amd64"
    xorriso -osirrox on -indev "${iso}" \
        -extract /386/bootx64.efi "${stage}/386/bootx64.efi" \
        -extract /amd64/9pc64 "${stage}/amd64/9pc64" 2>/dev/null ||
        die "found no 386/bootx64.efi and amd64/9pc64 on ${iso}"

    cat >"${stage}/plan9.ini" <<EOF
bootfile=/9pc64
console=0
cdboot=yes
nobootprompt=local!/dev/sdE0/linuxdata
user=glenda
EOF

    local esp
    esp="${work}/boot-esp.img"
    rm -f "${esp}"
    mkfs.vfat -C -n BUILD "${esp}" $((62 * 1024)) >/dev/null
    mmd -i "${esp}" ::/EFI ::/EFI/BOOT ::/inst ::/patch
    if [ arm64 = "${arch}" ]; then
        stage_arm64_patches "${stage}/patch"
        mcopy -i "${esp}" "${stage}/patch"/* ::/patch/
    fi
    mcopy -i "${esp}" "${stage}/386/bootx64.efi" ::/EFI/BOOT/BOOTX64.EFI
    mcopy -i "${esp}" "${stage}/amd64/9pc64" ::/9pc64
    mcopy -i "${esp}" "${stage}/plan9.ini" ::/plan9.ini
    mcopy -i "${esp}" "${here}/inst/run.rc" "${here}/inst/prompt.rc" "${here}/inst/answers" ::/inst/

    local iso_mib
    iso_mib=$((($(wc -c <"${iso}") + 1048575) / 1048576))

    boot_disk="${work}/boot.img"
    rm -f "${boot_disk}"
    truncate -s "$((64 + iso_mib + 1))M" "${boot_disk}"
    sgdisk -n 1:2048:+62M -t 1:EF00 \
        -n "2:$((64 * 2048)):+${iso_mib}M" -t 2:8300 "${boot_disk}" >/dev/null
    dd if="${esp}" of="${boot_disk}" bs=1M seek=1 conv=notrunc status=none
    dd if="${iso}" of="${boot_disk}" bs=1M seek=64 conv=notrunc status=none
}

show_console() {
    printf '%s\n' '----- 9front console -----'
    serial_text
    printf '\n%s\n' '----- end 9front console -----'
}

run_install() {
    rm -f "${out}"
    truncate -s "${image_size_mib}M" "${out}"

    local disks=()
    mapfile -t -O "${#disks[@]}" disks < <(qemu_disk 0 "${boot_disk}")
    mapfile -t -O "${#disks[@]}" disks < <(qemu_disk 1 "${out}")
    if [ arm64 = "${arch}" ]; then
        mapfile -t -O "${#disks[@]}" disks < <(qemu_disk 2 "${arm64_dist}" snapshot)
    fi

    log "booting the ${version} live system ($(qemu_accel))"
    qemu_start "${work}/qemu" "${disks[@]}"
    trap 'qemu_stop' EXIT

    if ! wait_for 'term% ' "${boot_timeout}"; then
        show_console
        die "the live system did not reach a shell within ${boot_timeout}s"
    fi

    local from
    from="$(serial_size)"
    log "running inst/run.rc"
    send_line "test -e /srv/dos || dossrv; mount -c /srv/dos /n/build /dev/sdE0/esp && rc /n/build/inst/run.rc ${arch}"

    if ! wait_for '9front-build: (done|FAILED)' "${build_timeout}" "${from}"; then
        show_console
        die "the install did not finish within ${build_timeout}s"
    fi
    if tail -c "+$((from + 1))" "${SERIAL_LOG}" | grep -aq '9front-build: FAILED'; then
        show_console
        die "the install failed"
    fi

    if ! wait_for_exit 600; then
        show_console
        die "the live system did not halt after the install"
    fi
    qemu_stop
    trap - EXIT
    show_console
}

check_image() {
    local table
    table="$(sgdisk -p "${out}")"
    printf '%s\n' "${table}"
    grep -q ' EF00 ' <<<"${table}" || die "${out} has no EFI system partition"
    grep -q ' 3900 ' <<<"${table}" || die "${out} has no Plan 9 partition"
}

case "${arch}" in
amd64) ;;
arm64) need patch qemu-img ;;
*) die "ARCH is amd64 or arm64, not ${arch}" ;;
esac
need curl sha256sum gzip xorriso mkfs.vfat mmd mcopy sgdisk truncate dd qemu-system-x86_64

fetch_iso
if [ arm64 = "${arch}" ]; then
    fetch_arm64_dist
fi
make_boot_disk
run_install
check_image
log "built ${out}"
